{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "urlz",
    "main": "src/index.ts",
    "compatibility_date": "2026-06-17",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "binding": "ASSETS",
        "directory": "./public",
    },
    "observability": {
        "enabled": true,
    },
    "upload_source_maps": true,
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "urlz",
            "preview_database_id": "c020574a-5623-407b-be0c-cd192bab9545",
            "database_id": "4f4c4dcc-ac8b-4e3e-98c5-9043178ab3b0",
        },
    ],
    "kv_namespaces": [
        {
            "binding": "KV",
            "preview_id": "d7b3a1f4e1c34e8f9a2b3c4d5e6f7g8h",
            "id": "8ecb386c5e2e498db74fe0b346dcc5cb",
        },
    ],
    "vars": {
        "KV_CACHE_ENABLED": "true",
    },
}
