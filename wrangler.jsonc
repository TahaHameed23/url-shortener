{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "urlz",
    "main": "src/index.ts",
    "compatibility_date": "2026-06-17",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "binding": "ASSETS",
        "directory": "./public",
    },
    "observability": {
        "enabled": true,
    },
    "upload_source_maps": true,
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "urlz",
            "migrations_dir": "migrations",
            "preview_database_id": "3f06d718-03d6-4a6d-83c3-05ceb878dc09",
            "database_id": "4f4c4dcc-ac8b-4e3e-98c5-9043178ab3b0",
        },
    ],
    "kv_namespaces": [
        {
            "binding": "KV",
            "preview_id": "c0f2eec09fbe4b2c872dde1ecdf51a64",
            "id": "8ecb386c5e2e498db74fe0b346dcc5cb",
        },
    ],
    "previews": {
        "vars": {
            "KV_CACHE_ENABLED": "true",
        },
        "kv_namespaces": [
            {
                "binding": "KV",
                "id": "c0f2eec09fbe4b2c872dde1ecdf51a64",
            },
        ],
        "d1_databases": [
            {
                "binding": "DB",
                "database_id": "3f06d718-03d6-4a6d-83c3-05ceb878dc09",
            },
        ],
    },
    "vars": {
        "KV_CACHE_ENABLED": "true",
    },
    "secrets": {
        "required": ["AUTH_SECRET"],
    },
}
