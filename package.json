{
    "name": "urlz",
    "type": "module",
    "scripts": {
        "build:web": "vite build",
        "build:extension": "vite build --config web/extension/vite.config.ts",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "test:unit": "bun test tests/auth-cookie.test.ts tests/auth.test.ts tests/safe-url.test.ts",
        "test:integration": "bun test tests/api.integration.test.ts tests/auth-routes.test.ts",
        "test:e2e": "bun run build:e2e && bun run e2e:db && bunx playwright test",
        "build:e2e": "vite build --outDir ../.wrangler/e2e-assets",
        "e2e:db": "wrangler d1 migrations apply urlz --local --persist-to .wrangler/e2e-state",
        "e2e:dev": "wrangler dev --local --persist-to .wrangler/e2e-state --port 8788 --assets .wrangler/e2e-assets --var AUTH_SECRET:e2e-only-test-secret",
        "dev:web": "vite",
        "dev": "bun run build:web && wrangler dev",
        "db:migrations": "wrangler d1 migrations list urlz --local",
        "db:migrate:local": "wrangler d1 migrations apply urlz --local",
        "db:migrate:preview": "wrangler d1 migrations apply urlz --remote --preview",
        "db:migrate:remote": "wrangler d1 migrations apply urlz --remote",
        "deploy:preview": "wrangler preview --secrets-file .dev.vars",
        "deploy": "wrangler deploy --minify",
        "cf-typegen": "wrangler types --env-interface CloudflareBindings"
    },
    "dependencies": {
        "base62": "^2.0.2",
        "hono": "^4.12.25",
        "lucide-react": "0.468.0",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^25.9.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "wrangler": "4.151.1"
    }
}
